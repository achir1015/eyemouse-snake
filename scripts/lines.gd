static var _all := {}


static func all() -> Dictionary:
	if not _all.is_empty():
		return _all
	_all = L.duplicate()
	for k in FACTS:
		_all[k] = str(FACTS[k][1]) + "。" + str(FACTS[k][2])
	return _all


static func facts_of(cat: String) -> Array:
	var out := []
	for k in FACTS:
		if FACTS[k][0] == cat:
			out.append(k)
	return out


static func text(id: String) -> String:
	return str(all().get(id, ""))
