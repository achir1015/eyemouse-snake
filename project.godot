; Engine configuration file.
; 眼動鼠貪吃蛇（資料夾：E:\貪吃蛇遊戲\eyemouse-snake）

config_version=5

[application]

config/name="眼動鼠貪吃蛇"
config/description="眼動鼠 3D 貪吃蛇：像蟻人一樣縮小，在量子領域、星雲宇宙、微觀花園的立體曲面空間裡，用眼睛控制蛇吃蘋果"
config/version="1.0.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.png"
boot_splash/bg_color=Color(0.03, 0.05, 0.12, 1)
boot_splash/show_image=false
config/quit_on_go_back=false
config/windows_native_icon="res://platform/icon.ico"
run/low_processor_mode=false

[audio]

general/text_to_speech=true
general/ios/session_category=3
general/ios/mix_with_others=false

[autoload]

App="*res://scripts/app.gd"
EyeCam="*res://scripts/eyecam.gd"
Gaze="*res://scripts/gaze.gd"
Snd="*res://scripts/snd.gd"
Updater="*res://scripts/updater.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/ui_font.tres"

[input_devices]

pointing/emulate_touch_from_mouse=false

[physics]

common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
renderer/rendering_method.web="gl_compatibility"
renderer/rendering_method.macos="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=0
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
anti_aliasing/quality/screen_space_aa=1
environment/defaults/default_clear_color=Color(0.02, 0.03, 0.08, 1)
